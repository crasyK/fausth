{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fausth.dev/schema/fausth-mcp-descriptor.v0.1.json",
  "title": "Fausth MCP connector descriptor v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "provides"],
  "properties": {
    "format": {
      "const": "fausth-mcp-descriptor/v0.1"
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mcp_tool": {
            "type": "string",
            "minLength": 1,
            "description": "Remote MCP tool name; defaults to id when omitted."
          },
          "description": { "type": "string" },
          "read_only": { "type": "boolean" },
          "input": { "type": "object" },
          "output": { "type": "object" },
          "verify": { "type": "array" }
        }
      }
    }
  }
}
