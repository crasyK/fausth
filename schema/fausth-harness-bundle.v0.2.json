{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fausth.dev/schema/fausth-harness-bundle.v0.2.json",
  "title": "Fausth harness bundle v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "files", "resolved", "resolved_sha256"],
  "properties": {
    "format": {
      "const": "fausth-harness-bundle/v0.2"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 96,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(agent\\.(yml|yaml|json)|README\\.md|smoke\\.(model|expected)\\.jsonl|deployment\\.[A-Za-z0-9._-]+\\.ya?ml|connectors\\.(yml|yaml|json)|connectors/[A-Za-z0-9._-]+\\.(yml|yaml|json))$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1048576
      }
    },
    "resolved": {
      "$ref": "https://fausth.dev/schema/fausth-resolved-harness.v0.1.json"
    },
    "resolved_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
