{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fausth.dev/schema/counterbalance-contract.v0.2.json",
  "title": "Counterbalance Contract v0.2",
  "description": "Normative schema for counterbalance-contract/v0.2. See docs/spec-v0.2.md.",
  "type": "object",
  "required": ["spec", "name"],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "type": "string",
      "enum": ["counterbalance-contract/v0.2"]
    },
    "name": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
        "memory": { "type": "array", "items": { "$ref": "#/$defs/memorySlot" } },
        "instincts": { "type": "array", "items": { "$ref": "#/$defs/instinct" } }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gates": { "type": "array", "items": { "type": "object" } },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "can_correct": { "type": "array", "items": { "type": "string" } },
            "can_interrupt": { "type": "boolean" },
            "approval_required_for": { "type": "array", "items": { "type": "string" } }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permissions": { "type": "object" },
            "hooks": { "type": "array", "items": { "type": "object" } },
            "sequences": { "type": "array", "items": { "$ref": "#/$defs/sequence" } },
            "invalidate_after": {
              "type": "array",
              "items": { "$ref": "#/$defs/invalidateAfter" }
            }
          }
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lifecycle": { "type": "array", "items": { "type": "string" } },
        "completion": { "type": "object" },
        "recovery": { "type": "object" }
      }
    },
    "limits": { "type": "object" },
    "state": { "type": "object" },
    "counterbalance": { "$ref": "#/$defs/counterbalanceExt" }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "read_only": { "type": "boolean" },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "verify": { "type": "array" }
      }
    },
    "memorySlot": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string", "enum": ["user", "world", "agent-inference"] },
        "authority": { "type": "string", "enum": ["user", "world", "agent"] },
        "freshness": { "type": "string" },
        "correction": { "type": "string" }
      }
    },
    "instinct": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "directive": { "type": "string" },
        "when": { "type": "string" }
      }
    },
    "sequence": {
      "type": "object",
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "require_prior_tools": { "type": "array", "items": { "type": "string" } },
        "require_prior_any_of": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "At least one listed tool must have succeeded earlier (OR)."
        },
        "require_state": { "type": "object" }
      }
    },
    "invalidateAfter": {
      "type": "object",
      "required": ["action", "memory_keys"],
      "properties": {
        "action": { "type": "string" },
        "memory_keys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["tool", "allow_set_keys"],
      "properties": {
        "tool": { "type": "string" },
        "allow_set_keys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "denyFailureUnblock": {
      "type": "object",
      "required": ["tool", "set_key", "set_value"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "set_key": { "type": "string" },
        "set_value": true
      }
    },
    "denyFailureItem": {
      "type": "object",
      "required": ["path", "current", "require"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "current": true,
        "require": { "type": "object" },
        "unblock": { "$ref": "#/$defs/denyFailureUnblock" }
      }
    },
    "denyFailure": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "failed"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "predicate" },
            "failed": {
              "type": "array",
              "items": { "$ref": "#/$defs/denyFailureItem" }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "missing_prior_tools"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "missing_prior_tools" },
            "missing_prior_tools": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "options"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "missing_prior_any_of" },
            "options": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "checkpoint_key"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "checkpoint_key" },
            "checkpoint_key": { "type": "string" }
          }
        }
      ]
    },
    "counterbalanceExt": {
      "type": "object",
      "description": "Executable bridge on v0.1 IR — see docs/spec-v0.2.md §2",
      "additionalProperties": false,
      "properties": {
        "sequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/sequence" }
        },
        "invalidate_after": {
          "type": "array",
          "items": { "$ref": "#/$defs/invalidateAfter" }
        },
        "completion": {
          "type": "object",
          "properties": {
            "tool": { "type": "string" },
            "require": { "type": "object" }
          }
        },
        "checkpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkpoint" }
        },
        "orientation": {
          "type": "object",
          "properties": {
            "emit_each_step": { "type": "boolean" }
          }
        }
      }
    }
  }
}
