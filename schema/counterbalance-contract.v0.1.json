{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fausth.dev/schema/counterbalance-contract.v0.1.json",
  "title": "Counterbalance Contract — executable IR (spec ids v0.1, v0.2, v0.3)",
  "description": "The one executable harness IR shape. Normative text: docs/spec-v0.3.md (§2). The agent/world/exchange authoring shape (schema/counterbalance-contract.v0.2.json) is a draft and is not loadable. Structural rules that JSON Schema cannot express (declared references, scopes, canonical values, predicate roots) are enforced by the validators (spec-v0.3 §2.6).",
  "type": "object",
  "required": [
    "spec",
    "name",
    "state",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "type": "string",
      "enum": [
        "counterbalance-contract/v0.1",
        "counterbalance-contract/v0.2",
        "counterbalance-contract/v0.3"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "safe_state": {
      "type": "object",
      "description": "Deprecated alias of fallback_state."
    },
    "fallback_state": {
      "type": "object"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Absent = every declared tool is permitted; [] = none (D5). Must list declared tools only."
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "write_scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "read_scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "description": "World-side secret declarations enforced by host world adapters (spec-v0.3 §4.3); declared values are redacted from world feedback (§14).",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deny_write_contains": {
              "type": "boolean"
            }
          }
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Paths whose baseline content must not change (host-enforced, spec-v0.3 §4.3)."
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "boolean",
          "description": "Spawn is denied unless exactly true (D6)."
        },
        "tighten_only": {
          "type": "boolean"
        },
        "allow_nested": {
          "type": "boolean"
        }
      }
    },
    "counterbalance": {
      "$ref": "#/$defs/counterbalance"
    },
    "mutable": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "skills",
          "memory",
          "instincts"
        ]
      },
      "description": "Agent-side cells the agent may edit (never security)."
    },
    "instinct_text": {
      "type": "string",
      "description": "Harness-authored disposition text; hosts include it verbatim in the model's system context."
    },
    "overlays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/overlay"
      },
      "description": "Model-adaptive, narrow-only overlays resolved by the host (spec-v0.3 §4.4)."
    }
  },
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path",
            "eq"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "eq": true
          }
        },
        {
          "type": "object",
          "required": [
            "path",
            "eq_path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "eq_path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "path",
            "neq"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "neq": true
          }
        },
        {
          "type": "object",
          "required": [
            "path",
            "lt"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "lt": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "path",
            "lte"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "lte": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "path",
            "gt"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "gt": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "path",
            "gte"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "gte": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          }
        }
      ]
    },
    "otherwise": {
      "type": "string",
      "enum": [
        "deny",
        "safe_state"
      ],
      "description": "Fallback verdict when the check fails. `allow` is not allowed: a failed check never counts as success."
    },
    "gate": {
      "type": "object",
      "required": [
        "require"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "require": {
          "$ref": "#/$defs/predicate"
        },
        "otherwise": {
          "$ref": "#/$defs/otherwise"
        }
      }
    },
    "verifyEffect": {
      "type": "object",
      "required": [
        "kind",
        "observe",
        "require"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "effect"
        },
        "require": {
          "$ref": "#/$defs/predicate"
        },
        "otherwise": {
          "$ref": "#/$defs/otherwise"
        },
        "observe": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verifyEvidence": {
      "type": "object",
      "required": [
        "kind",
        "require"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "require": {
          "$ref": "#/$defs/predicate"
        },
        "otherwise": {
          "$ref": "#/$defs/otherwise"
        }
      }
    },
    "verifyAbsence": {
      "type": "object",
      "required": [
        "kind",
        "require"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "absence"
        },
        "require": {
          "$ref": "#/$defs/predicate"
        },
        "otherwise": {
          "$ref": "#/$defs/otherwise"
        }
      }
    },
    "verifyOutput": {
      "type": "object",
      "required": [
        "kind",
        "require"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "output"
        },
        "require": {
          "$ref": "#/$defs/predicate"
        },
        "otherwise": {
          "$ref": "#/$defs/otherwise"
        }
      }
    },
    "verifyJudge": {
      "type": "object",
      "required": [
        "kind",
        "rubric",
        "require"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "judge"
        },
        "require": {
          "$ref": "#/$defs/predicate"
        },
        "otherwise": {
          "$ref": "#/$defs/otherwise"
        },
        "model_from": {
          "type": "string"
        },
        "rubric": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verify": {
      "oneOf": [
        {
          "$ref": "#/$defs/verifyEffect"
        },
        {
          "$ref": "#/$defs/verifyEvidence"
        },
        {
          "$ref": "#/$defs/verifyAbsence"
        },
        {
          "$ref": "#/$defs/verifyOutput"
        },
        {
          "$ref": "#/$defs/verifyJudge"
        }
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "channel": {
          "type": "string",
          "enum": [
            "world",
            "user"
          ],
          "description": "D14: `user` tools are answered by the host user channel (recorded / simulator / human), never synthesized. Default `world`."
        },
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        },
        "verify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verify"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": [
        "execute",
        "verify"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "string",
          "enum": [
            "verify_effect_failed",
            "verify_evidence_failed",
            "verify_absence_failed",
            "verify_output_failed",
            "verify_judge_invalid",
            "verify_judge_failed",
            "gate_denied"
          ]
        },
        "execute": {
          "type": "object",
          "required": [
            "tool"
          ],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "object"
            }
          }
        },
        "verify": {
          "$ref": "#/$defs/verify"
        },
        "on_failure": {
          "type": "string",
          "enum": [
            "terminal_failure"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "continue_after_deny": {
          "type": "boolean"
        },
        "max_observation_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sequence": {
      "type": "object",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "require_prior_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "require_prior_any_of": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "require_state": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "invalidateAfter": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "action",
            "memory_keys"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "memory_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ttl_steps",
            "memory_keys"
          ],
          "additionalProperties": false,
          "properties": {
            "ttl_steps": {
              "type": "integer",
              "minimum": 1
            },
            "memory_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "completion": {
      "type": "object",
      "required": [
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "require": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "tool",
        "allow_set_keys"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "allow_set_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "memoryProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "current",
            "stale",
            "contradicted",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "world",
            "agent-inference"
          ]
        },
        "updated_at_step": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "interventionBudget": {
      "type": "object",
      "required": [
        "max_activations"
      ],
      "additionalProperties": false,
      "properties": {
        "max_activations": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "type": "string",
          "enum": [
            "run",
            "host_day"
          ]
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "cron",
            "event",
            "human"
          ]
        },
        "every_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "counterbalance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Executable Counterbalance bridge (docs/spec-v0.3.md §8). Closed at every level.",
      "properties": {
        "sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequence"
          }
        },
        "invalidate_after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invalidateAfter"
          }
        },
        "completion": {
          "$ref": "#/$defs/completion"
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkpoint"
          }
        },
        "orientation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emit_each_step": {
              "type": "boolean"
            }
          }
        },
        "output_verifies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifyOutput"
          }
        },
        "memory_provenance": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/memoryProvenanceEntry"
          }
        },
        "intervention_budget": {
          "$ref": "#/$defs/interventionBudget"
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "memory_notes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": [
        "when_model"
      ],
      "additionalProperties": false,
      "properties": {
        "when_model": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_steps": {
              "type": "integer",
              "minimum": 0
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "prompt_hint": {
          "type": "string"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "set"
      ],
      "additionalProperties": false,
      "description": "Declared state effect: when `when` holds on {action, state, result}, `set` joins the call's transition (spec-v0.3 §6.3).",
      "properties": {
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "set": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          }
        }
      }
    }
  }
}
