# OpenRouter API key for Track B live verification (never commit real keys)
OPENROUTER_API_KEY=

# OpenAI API key (generic openai-compatible profile)
# OPENAI_API_KEY=

# KIT KI-Toolbox (institutional OpenAI-compatible gateway)
# KIT_AI_API_KEY=

# Ollama (optional; defaults to "ollama" if unset)
# OLLAMA_API_KEY=ollama

# Optional: override OpenRouter base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: comma-separated free model fallback list
# OPENROUTER_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
