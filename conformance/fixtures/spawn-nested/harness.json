{
  "spec": "harness/0.5",
  "name": "spawn-nested",
  "prompt": "Delegate.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    },
    "core_spawn": {}
  },
  "hooks": [
    {
      "id": "parent-rule",
      "on": "pre_tool",
      "match": "echo",
      "run": "core_context",
      "with": {
        "text": "parent rule"
      }
    }
  ],
  "limits": {
    "max_depth": 2,
    "max_steps": 20
  }
}
