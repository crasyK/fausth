{
  "spec": "harness/0.5",
  "name": "builtin-context-events",
  "prompt": "Use echo.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    }
  },
  "hooks": [
    {
      "id": "ctx-session_start",
      "on": "session_start",
      "run": "core_context",
      "with": {
        "text": "note for session_start"
      }
    },
    {
      "id": "ctx-user_prompt",
      "on": "user_prompt",
      "run": "core_context",
      "with": {
        "text": "note for user_prompt"
      }
    },
    {
      "id": "ctx-pre_request",
      "on": "pre_request",
      "run": "core_context",
      "with": {
        "text": "note for pre_request"
      }
    },
    {
      "id": "ctx-pre_tool",
      "on": "pre_tool",
      "run": "core_context",
      "with": {
        "text": "note for pre_tool"
      }
    },
    {
      "id": "ctx-post_tool",
      "on": "post_tool",
      "run": "core_context",
      "with": {
        "text": "note for post_tool"
      }
    },
    {
      "id": "ctx-stop",
      "on": "stop",
      "run": "core_context",
      "with": {
        "text": "note for stop"
      }
    }
  ]
}
