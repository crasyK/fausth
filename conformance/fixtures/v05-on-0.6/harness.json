{
  "spec": "harness/0.5",
  "name": "v05-on-0.6",
  "prompt": "Take notes.",
  "tools": {
    "zeta": {
      "description": "Tool zeta.",
      "input": {
        "type": "object",
        "required": [
          "k"
        ]
      }
    },
    "alpha": {
      "description": "Tool alpha.",
      "input": {
        "type": "object"
      }
    }
  },
  "handlers": {
    "seer": {
      "description": "Sees what 0.5.6 showed: no usage, no reasoning, no args_text.",
      "input": {
        "type": "object",
        "not": {
          "required": [
            "usage"
          ]
        },
        "properties": {
          "context": {
            "type": "array",
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "reasoning"
                    ]
                  },
                  {
                    "required": [
                      "reasoning_opaque"
                    ]
                  },
                  {
                    "required": [
                      "args_text"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "keeper": {
      "description": "Asks for a keep, which 0.5 doesn't have."
    }
  },
  "hooks": [
    {
      "id": "seer",
      "on": "pre_request",
      "run": "seer"
    },
    {
      "id": "keeper",
      "on": "pre_request",
      "run": "keeper",
      "on_failure": "skip"
    }
  ]
}
