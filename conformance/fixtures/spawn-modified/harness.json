{
  "spec": "harness/0.5",
  "name": "spawn-modified",
  "prompt": "Delegate.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    },
    "core_spawn": {}
  },
  "handlers": {
    "house_rules": {
      "input": {
        "required": [
          "call"
        ],
        "properties": {
          "call": {
            "properties": {
              "tool": {
                "const": "core_spawn"
              }
            }
          }
        }
      }
    }
  },
  "hooks": [
    {
      "id": "add-rules",
      "on": "pre_tool",
      "match": "core_spawn",
      "run": "house_rules"
    },
    {
      "id": "audit",
      "on": "post_tool",
      "match": "core_spawn",
      "run": "core_context",
      "with": {
        "text": "Child finished."
      }
    }
  ]
}
