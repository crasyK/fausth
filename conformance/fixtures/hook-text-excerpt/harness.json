{
  "spec": "harness/0.5",
  "name": "hook-text-excerpt",
  "prompt": "Use echo.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    }
  },
  "handlers": {
    "verbose": {}
  },
  "hooks": [
    {
      "id": "verbose",
      "on": "post_tool",
      "run": "verbose"
    },
    {
      "id": "short",
      "on": "post_tool",
      "run": "core_context",
      "with": {
        "text": "a </hook> b"
      }
    }
  ],
  "limits": {
    "max_hook_text": 12
  }
}
