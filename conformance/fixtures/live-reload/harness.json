{
  "spec": "harness/0.5",
  "name": "live-reload",
  "prompt": "You are v1.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    }
  },
  "hooks": [
    {
      "id": "v1-rules",
      "on": "session_start",
      "run": "core_context",
      "with": {
        "text": "v1 rules"
      }
    },
    {
      "id": "v1-heard",
      "on": "interrupt",
      "run": "core_context",
      "with": {
        "text": "v1 heard it"
      }
    }
  ],
  "limits": {
    "max_steps": 10
  }
}
