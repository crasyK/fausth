{
  "spec": "harness/0.5",
  "name": "hook-failed",
  "prompt": "Use echo.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    }
  },
  "handlers": {
    "flaky": {},
    "broken": {},
    "picky": {
      "input": {
        "required": [
          "nonexistent"
        ]
      }
    },
    "wrong": {},
    "extra": {},
    "strict": {}
  },
  "hooks": [
    {
      "id": "flaky",
      "on": "pre_tool",
      "run": "flaky",
      "on_failure": "skip"
    },
    {
      "id": "broken",
      "on": "pre_tool",
      "run": "broken",
      "on_failure": "skip"
    },
    {
      "id": "picky",
      "on": "pre_tool",
      "run": "picky",
      "on_failure": "skip"
    },
    {
      "id": "wrong",
      "on": "post_tool",
      "run": "wrong",
      "on_failure": "skip"
    },
    {
      "id": "extra",
      "on": "post_tool",
      "run": "extra",
      "on_failure": "skip"
    },
    {
      "id": "strict",
      "on": "stop",
      "run": "strict"
    }
  ]
}
