{
  "spec": "harness/0.4-draft",
  "name": "interrupts",
  "prompt": "Use echo.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    },
    "core_spawn": {}
  },
  "handlers": {
    "triage": {
      "input": {
        "required": [
          "interrupt"
        ],
        "properties": {
          "interrupt": {
            "required": [
              "source",
              "text"
            ]
          }
        }
      }
    }
  },
  "hooks": [
    {
      "id": "mute-timers",
      "on": "interrupt",
      "match": "timer",
      "run": "core_deny",
      "with": {
        "text": "timers are muted"
      }
    },
    {
      "id": "user-note",
      "on": "interrupt",
      "match": [
        "user"
      ],
      "run": "core_context",
      "with": {
        "text": "The user interrupted."
      }
    },
    {
      "id": "triage",
      "on": "interrupt",
      "match": "world",
      "run": "triage"
    }
  ]
}
