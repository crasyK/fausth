{
  "spec": "harness/0.6",
  "name": "v06-replace-context-keep",
  "prompt": "Work.",
  "tools": {
    "ls": {
      "description": "List files.",
      "input": {
        "type": "object"
      }
    }
  },
  "handlers": {
    "compact": {
      "description": "Summarises the conversation."
    },
    "compact_bad": {
      "description": "Returns decisions that fail."
    }
  },
  "hooks": [
    {
      "id": "bad",
      "on": "pre_request",
      "run": "compact_bad",
      "on_failure": "skip"
    },
    {
      "id": "compact",
      "on": "pre_request",
      "run": "compact"
    }
  ],
  "limits": {
    "max_hook_text": 20
  }
}
