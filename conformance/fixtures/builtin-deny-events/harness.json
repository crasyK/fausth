{
  "spec": "harness/0.5",
  "name": "builtin-deny-events",
  "prompt": "Use echo.",
  "tools": {
    "echo": {
      "description": "Echo the input.",
      "input": {
        "type": "object"
      }
    },
    "rm": {
      "description": "Remove a file.",
      "input": {
        "type": "object"
      }
    }
  },
  "hooks": [
    {
      "id": "no-rm",
      "on": "pre_tool",
      "match": "rm",
      "run": "core_deny",
      "with": {
        "text": "rm is not allowed here"
      }
    },
    {
      "id": "logged",
      "on": "post_tool",
      "match": "echo",
      "run": "core_deny",
      "with": {
        "text": "This call was logged."
      }
    },
    {
      "id": "keep-going",
      "on": "stop",
      "run": "core_deny",
      "with": {
        "text": "Keep going."
      }
    }
  ],
  "limits": {
    "max_continues": 1
  }
}
