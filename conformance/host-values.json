  {
   "name": "a slot with a value is filled",
   "harness": {
    "spec": "harness/0.7",
    "name": "m",
    "prompt": "A\n\n${TOOLCHAIN}\n\nB",
    "host_values": [
     "TOOLCHAIN"
    ]
   },
   "values": {
    "TOOLCHAIN": "Python toolchain: python3=missing."
   },
   "filled": {
    "spec": "harness/0.7",
    "name": "m",
    "prompt": "A\n\nPython toolchain: python3=missing.\n\nB",
    "host_values": [
     "TOOLCHAIN"
    ]
   }
  },
  {
