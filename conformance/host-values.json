{
 "about": "Spec v0.7 section 2.1. Each case fills `harness` with `values`; the result must equal `filled` (same canonical form), or the fill must fail when `error` is true.",
 "cases": [
  {
   "name": "placeholders in the prompt, standard and declared",
   "harness": {
    "spec": "harness/0.7",
    "name": "m",
    "prompt": "Main documentation: ${PKG}/README.md\nCurrent working directory: ${CWD}",
    "host_values": [
     "PKG"
    ]
   },
   "values": {
    "CWD": "/app",
    "HOME": "/root",
    "DATE": "2026-11-26",
    "YEAR": "2026",
    "TIMEZONE": "UTC+00:00",
    "OS": "Linux",
    "MODEL": "glm-5.3-flash",
    "PROVIDER": "openai",
    "PKG": "/usr/lib/pi"
   },
   "filled": {
    "spec": "harness/0.7",
    "name": "m",
    "prompt": "Main documentation: /usr/lib/pi/README.md\nCurrent working directory: /app",
    "host_values": [
     "PKG"
    ]
   }
  },
  {
   "name": "tool descriptions are filled; handler descriptions, texts and with are not",
   "harness": {
    "spec": "harness/0.7",
    "name": "m",
    "prompt": "p",
    "tools": {
     "websearch": {
      "description": "The current year is ${YEAR}.",
      "input": {
       "type": "object"
      }
     },
     "core_spawn": {
      "description": "Spawn in ${CWD}."
     }
    },
    "handlers": {
     "x": {
      "description": "${YEAR}"
     }
    },
    "texts": {
     "tool_error": "${YEAR} {error}"
    },
    "hooks": [
     {
      "id": "a",
      "on": "stop",
      "run": "x",
      "with": {
       "text": "${YEAR}"
      }
     }
    ]
   },
   "values": {
    "CWD": "/app",
    "HOME": "/root",
    "DATE": "2026-11-26",
    "YEAR": "2026",
    "TIMEZONE": "UTC+00:00",
    "OS": "Linux",
    "MODEL": "glm-5.3-flash",
    "PROVIDER": "openai"
   },
   "filled": {
    "spec": "harness/0.7",
    "name": "m",
    "prompt": "p",
    "tools": {
     "websearch": {
      "description": "The current year is 2026.",
      "input": {
       "type": "object"
      }
     },
     "core_spawn": {
      "description": "Spawn in /app."
