        "observe": "sensor.fan.read_percent",
        "require": {
          "path": "observation.percent",
          "eq": 0
        }
      }
    },
    "gates": [
      {
        "when": {
          "path": "action.args.percent",
          "eq": 0
        },
        "require": {
          "path": "state.fan_percent",
          "eq": 999
        }
      }
    ]
  },
  "model_lines": [
    {
      "type": "tool",
      "name": "actuator.fan.set",
      "args": {
        "percent": 40
      }
    }
  ],
  "expect": {
    "contains": [
      {
        "stage": "authorize",
        "verdict": "deny",
        "reason": "gate_denied",
        "tool": "actuator.fan.set",
        "args": {
          "percent": 0
        }
      },
      {
        "stage": "record",
        "reason": "terminal_failure"
      }
    ],
    "absent": [
