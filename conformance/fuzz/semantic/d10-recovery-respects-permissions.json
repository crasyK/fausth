{
  "world": "replay",
  "id": "d10-recovery-respects-permissions",
  "decision": "D10",
  "finding": "PY-15",
  "kind": "run",
  "agent": {
    "spec": "counterbalance-contract/v0.1",
    "name": "semantic",
    "state": {
      "fan_percent": 0
    },
    "tools": [
      {
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "id": "sensor.fan.read_percent",
        "read_only": true
      },
      {
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "id": "actuator.fan.set",
        "verify": [
          {
