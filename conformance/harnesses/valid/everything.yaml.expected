{"handlers":{"judge_reason":{"description":"Ask a model whether a reason is good enough.","input":{"required":["call"],"type":"object"}},"list_skills":{}},"hooks":[{"id":"skills","on":"session_start","on_failure":"skip","run":"list_skills"},{"id":"house-rules","on":"session_start","run":"core_context","with":{"text":"Be brief."}},{"id":"screen","on":"user_prompt","run":"judge_reason"},{"id":"no-empty-prompt","on":"user_prompt","run":"core_deny","with":{"text":"say something"}},{"id":"compact","on":"pre_request","run":"judge_reason","with":{"threshold":9000}},{"id":"tip","on":"pre_request","run":"core_context","with":{"text":"Think first."}},{"id":"search-budget","match":"search","on":"pre_tool","run":"core_count","with":{"max":3,"tool":"search"}},{"id":"reason-check","match":["search","tests_run"],"on":"pre_tool","run":"judge_reason"},{"id":"spawn-after-search","match":"core_spawn","on":"pre_tool","run":"core_called_since","with":{"tool":"search"}},{"id":"result-note","on":"post_tool","run":"core_context","with":{"text":"Check the result."}},{"id":"tests-pass","on":"stop","run":"core_last_result","with":{"eq":0,"path":"exit_code","tool":"tests_run"}},{"id":"tests-first","on":"stop","run":"core_called_since","with":{"since":"search","tool":"tests_run"}},{"id":"timer-only","match":["timer","job"],"on":"interrupt","run":"core_deny","with":{"text":"dropped"}},{"id":"interrupt-note","match":"*","on":"interrupt","run":"core_context","with":{"text":"An event arrived."}}],"limits":{"max_continues":3,"max_depth":2,"max_hook_text":2000,"max_steps":40,"max_tool_calls":80,"timeout_ms":600000},"name":"everything","prompt":"Use the tools.","spec":"harness/0.5","tools":{"core_spawn":{"description":"Hand a subtask to a child harness you write."},"search":{"description":"Search the notes.","input":{"additionalProperties":false,"properties":{"limit":{"maximum":50,"minimum":1,"type":"integer"},"query":{"minLength":1,"type":"string"}},"required":["query"],"type":"object"},"output":{"properties":{"hits":{"items":{"type":"string"},"type":"array"}},"required":["hits"],"type":"object"}},"tests_run":{"description":"Run the tests.","input":{"additionalProperties":false,"type":"object"}}}}
