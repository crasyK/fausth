{"hooks":[{"id":"observe-first","match":"board_move","on":"pre_tool","run":"core_called_since","with":{"tool":"board_observe"}},{"id":"legal-moves-first","match":"board_move","on":"pre_tool","run":"core_called_since","with":{"since":"board_move","tool":"board_legal_moves"}}],"limits":{"max_steps":12,"max_tool_calls":12},"name":"chess-legal-first","prompt":"You are playing chess. Find the best move for the side to move and play it.\n","spec":"harness/0.4-draft","tools":{"board_legal_moves":{"description":"List every legal move for the side to move, in UCI and SAN.","input":{"additionalProperties":false,"properties":{},"type":"object"}},"board_move":{"description":"Play one move in UCI notation (e.g. e2e4). Include reason: why this move.","input":{"additionalProperties":false,"properties":{"move":{"type":"string"},"position_hash":{"type":"string"},"reason":{"type":"string"}},"required":["move","position_hash","reason"],"type":"object"}},"board_observe":{"description":"Read the current position: FEN, side to move, whether in check, position_hash.","input":{"additionalProperties":false,"properties":{},"type":"object"}}}}
